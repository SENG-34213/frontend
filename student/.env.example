# Development: use the local backend gateway.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_APP_BASE_PATH=

# Production: use /api when frontend and backend share the same Caddy origin.
# NEXT_PUBLIC_API_BASE_URL=/api
# NEXT_PUBLIC_APP_BASE_PATH=/student

# Optional realtime communication endpoint.
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8080
